# TourFlow AI Enterprise Environment Configuration

# Gemini API Key (Server-Side Only)
GEMINI_API_KEY=

# Gemini Model Designations & Cascading Fallbacks
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-3.7-flash,gemini-flash-latest,gemini-3.1-flash-lite

# Gemini Hyperparameters & Generation Controls
GEMINI_TEMPERATURE=1.0
GEMINI_CONVERSATIONAL_TEMPERATURE=1.0
GEMINI_STRUCTURED_TEMPERATURE=1.0
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TOP_P=0.95
GEMINI_TOP_K=40

# Resilience & Exponential Backoff Settings
GEMINI_MAX_RETRIES=3
GEMINI_INITIAL_BACKOFF_MS=1000
GEMINI_MAX_BACKOFF_MS=10000
GEMINI_TIMEOUT_MS=30000

# Database Configuration
DATABASE_URL=sqlite:///./tourflow.db

# Application Configuration
APP_URL=http://localhost:3000
BACKEND_PORT=3000
ENVIRONMENT=development
LOG_LEVEL=info
